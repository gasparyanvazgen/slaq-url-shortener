# Slaq local configuration. Copy to `.env` (ignored) and adjust as needed.

# Port the HTTP server listens on. Optional; defaults to 3000 in every environment.
# When set it must be ASCII digits only with a value from 1 to 65535.
# Leading zeros are allowed and insignificant; 0 and 0000 are rejected.
PORT=3000

# Public origin used to build short URLs. Optional in development, required in
# production. Absolute http(s) URL with no credentials, path, query, or fragment.
# Development default: http://localhost:${PORT}
PUBLIC_BASE_URL=http://localhost:3000

# development | production | test. Anything other than `production` uses the
# development defaults. Defaults to `development` when unset.
NODE_ENV=development
